{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    // Necesario para importar "../src/data/site.ts" con extension.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // src/data/site.ts entra a proposito: es la fuente unica del correo,
  // el WhatsApp y el nombre de marca, y el correo automatico los usa.
  // Son constantes puras, sin DOM ni React, asi que el Worker las bundlea
  // sin arrastrar nada del frontend.
  "include": ["worker", "src/data/site.ts"]
}
