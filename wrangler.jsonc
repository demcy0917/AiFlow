{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiflow-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-20",
  // Sitio estático (Vite SPA) servido desde "dist", con un Worker de Hono
  // por delante que atiende únicamente las rutas /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sin esto, el fallback de SPA se tragaría /api/* y devolvería index.html.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Rate limiting nativo del borde, por IP. No usa KV, así que no hay costo
  // de escrituras ni latencia extra. El período solo admite 10 o 60 segundos.
  "unsafe": {
    "bindings": [
      {
        "name": "CHAT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 15, "period": 60 }
      },
      {
        "name": "CONTACT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 3, "period": 60 }
      }
    ]
  }
}
